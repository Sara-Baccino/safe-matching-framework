{
  "population": {
    "direction": "treated_to_control"
  },
  "variables": {
    "matching": [
      "Age",
      "BMI",
      "ALT"
    ],
    "stratification": [
      "Male"
    ],
    "evaluation": [
      "Diabetes"
    ]
  },
  "constraints": {
    "calipers": [
      {
        "variable": "Age",
        "value": 5,
        "scale": "absolute"
      }
    ],
    "global_caliper": null
  },
  "metrics": {
    "name": "manhattan",
    "params": {}
  },
  "method": {
    "name": "partial_ot",
    "params": {
      "target_ratio": 2.0
    }
  },
  "validation": {
    "smd_threshold": 0.1,
    "balance_metrics": [
      "smd",
      "variance_ratio",
      "ks",
      "chi_square",
      "jensen_shannon"
    ],
    "success_criteria": {
      "min_match_rate": 0.8,
      "max_mean_abs_smd": 0.1,
      "max_abs_smd": 0.25,
      "min_pct_balanced": 90.0
    },
    "analysis": {
      "pca": true,
      "distributions": true,
      "correlations": true,
      "ps_support": true
    },
    "max_distribution_plots": 6,
    "plots": true,
    "hooks": []
  },
  "options": {
    "drop_rows_with_missing": true,
    "random_state": 42
  }
}