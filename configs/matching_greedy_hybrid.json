{
  "population": {
    "direction": "treated_to_control"
  },
  "variables": {
    "matching": [
      "Age",
      "BMI",
      "ALT"
    ],
    "stratification": [
      "Male"
    ],
    "evaluation": [
      "Diabetes"
    ]
  },
  "constraints": {
    "calipers": [
      {
        "variable": "Age",
        "value": 5,
        "scale": "absolute"
      }
    ],
    "global_caliper": null
  },
  "metrics": {
    "name": "hybrid",
    "params": {}
  },
  "method": {
    "name": "greedy_nn",
    "params": {
      "ratio_k": 2,
      "order": "random"
    }
  },
  "validation": {
    "smd_threshold": 0.1,
    "balance_metrics": [
      "smd",
      "variance_ratio",
      "ks",
      "chi_square",
      "jensen_shannon"
    ],
    "success_criteria": {
      "min_match_rate": 0.8,
      "max_mean_abs_smd": 0.1,
      "max_abs_smd": 0.25,
      "min_pct_balanced": 90.0
    },
    "analysis": {
      "pca": true,
      "distributions": true,
      "correlations": true,
      "ps_support": true
    },
    "max_distribution_plots": 6,
    "plots": true,
    "hooks": []
  },
  "options": {
    "drop_rows_with_missing": true,
    "random_state": 42
  },
  "estimation": {
    "enabled": true,
    "estimands": [
      "ATT"
    ],
    "outcomes": [
      {
        "variable": "Outcome",
        "type": "continuous"
      },
      {
        "variable": "Event",
        "type": "binary"
      }
    ],
    "bootstrap": {
      "n_boot": 200,
      "ci_level": 0.95,
      "resample": "full_pipeline",
      "n_jobs": 1
    }
  }
}