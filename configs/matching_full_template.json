{
  "$schema": "./matching_config.schema.json",
  "_note": "Config completo: ogni parametro e' mostrato col suo default. Le chiavi che iniziano con '_' sono commenti e vengono ignorate.",
  "population": {
    "direction": "treated_to_control"
  },
  "variables": {
    "matching": [
      "Age",
      "BMI",
      "ALT"
    ],
    "stratification": [
      "Male"
    ],
    "evaluation": [
      "Diabetes"
    ]
  },
  "constraints": {
    "calipers": [
      {
        "variable": "Age",
        "value": 5.0,
        "scale": "absolute"
      }
    ],
    "global_caliper": null
  },
  "metrics": {
    "name": "euclidean",
    "params": {}
  },
  "method": {
    "name": "propensity_score",
    "params": {
      "model": "logistic",
      "model_params": {},
      "poly_degree": 1,
      "C": 0.5,
      "max_iter": 5000,
      "cross_fit": null,
      "cross_fit_folds": 5,
      "include_stratification": true,
      "match_on": "logit",
      "caliper_sd": 0.2,
      "trim": "none",
      "trim_quantile": 0.02,
      "algorithm": "greedy_nn",
      "algorithm_params": {}
    }
  },
  "validation": {
    "analysis": {
      "pca": true,
      "pca_variance_target": 0.8,
      "pca_loadings_components": 3,
      "distributions": true,
      "correlations": true,
      "correlation_method": "pearson",
      "max_correlation_variables": 25,
      "max_scatter_points": 3000,
      "ps_support": true,
      "ps_support_bins": 30
    },
    "success_criteria": {
      "min_match_rate": 0.8,
      "max_mean_abs_smd": 0.1,
      "max_abs_smd": 0.25,
      "min_pct_balanced": 90.0,
      "require_improvement": true,
      "max_pca_smd": null,
      "max_corr_diff": null
    },
    "smd_threshold": 0.1,
    "balance_metrics": [
      "smd",
      "variance_ratio",
      "ks",
      "chi_square",
      "jensen_shannon"
    ],
    "plots": true,
    "max_distribution_plots": 12,
    "hooks": []
  },
  "options": {
    "drop_rows_with_missing": true,
    "random_state": 42
  },
  "estimation": {
    "enabled": true,
    "estimands": [
      "ATT"
    ],
    "outcomes": [
      {
        "variable": "Outcome",
        "type": "continuous",
        "label": null
      },
      {
        "variable": "Event",
        "type": "binary",
        "label": null
      }
    ],
    "include_naive": true,
    "bootstrap": {
      "n_boot": 200,
      "ci_level": 0.95,
      "resample": "full_pipeline",
      "random_state": null,
      "n_jobs": 1
    }
  },
  "_method_options": {
    "propensity_score": {
      "model": "logistic",
      "model_params": {},
      "poly_degree": 1,
      "C": 0.5,
      "max_iter": 5000,
      "cross_fit": null,
      "cross_fit_folds": 5,
      "include_stratification": true,
      "match_on": "logit",
      "caliper_sd": 0.2,
      "trim": "none",
      "trim_quantile": 0.02,
      "algorithm": "greedy_nn",
      "algorithm_params": {}
    },
    "greedy_nn": {
      "ratio_k": 1,
      "replacement": false,
      "order": "given",
      "prefilter_k": null
    },
    "hungarian": {
      "prefilter_k": null
    },
    "sorted": {
      "sort_variable": null
    },
    "partial_ot": {
      "target_size": null,
      "target_ratio": 1.0,
      "nb_dummies": 10,
      "max_iterations": 1000000,
      "prefilter_k": null
    }
  },
  "_metric_options": {
    "euclidean": {
      "scale": "standard | minmax | none",
      "weights": {
        "<variabile>": 1.0
      }
    },
    "manhattan": {
      "scale": "standard | minmax | none",
      "weights": {
        "<variabile>": 1.0
      }
    },
    "mahalanobis": {
      "covariance": "total | within",
      "regularization": 1e-08
    },
    "hybrid": {
      "weight_numerical": 0.6,
      "weight_categorical": 0.4,
      "weights": {
        "<variabile>": 1.0
      }
    },
    "gower": {
      "weights": {
        "<variabile>": 1.0
      }
    }
  },
  "_enum_values": {
    "population.direction": [
      "treated_to_control",
      "control_to_treated"
    ],
    "constraints.calipers[].scale": [
      "absolute",
      "standard_deviation"
    ],
    "metrics.name": [
      "euclidean",
      "manhattan",
      "mahalanobis",
      "hybrid",
      "gower"
    ],
    "method.name": [
      "greedy_nn",
      "hungarian",
      "partial_ot",
      "propensity_score",
      "sorted"
    ],
    "method.params.model (propensity_score)": [
      "logistic",
      "random_forest",
      "xgboost",
      "gradient_boosting"
    ],
    "method.params.algorithm (propensity_score)": [
      "greedy_nn",
      "hungarian",
      "sorted",
      "partial_ot"
    ],
    "method.params.trim (propensity_score)": [
      "none",
      "minmax",
      "quantile"
    ],
    "validation.balance_metrics": [
      "smd",
      "variance_ratio",
      "ks",
      "chi_square",
      "jensen_shannon",
      "wasserstein"
    ],
    "validation.analysis.correlation_method": [
      "pearson",
      "spearman"
    ],
    "estimation.estimands": [
      "ATT",
      "ATC",
      "ATE"
    ],
    "estimation.outcomes[].type": [
      "continuous",
      "binary"
    ],
    "estimation.bootstrap.resample": [
      "full_pipeline",
      "matched_pairs"
    ]
  }
}