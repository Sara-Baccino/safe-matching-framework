{
  "population": {
    "direction": "treated_to_control"
  },
  "variables": {
    "matching": [
      "Maternal_Age"
    ],
    "stratification": [
      "Infert"
    ],
    "evaluation": [
      "TOT_clinical_pregnancies",
      "TOT_miscarriages",
      "TOT_bambini_nati"
    ]
  },
  "constraints": {
    "calipers": [
      {
        "variable": "Maternal_Age",
        "value": 0.2,
        "scale": "absolute"
      }
    ],
    "global_caliper": null
  },
  "metrics": {
    "name": "mahalanobis",
    "params": {}
  },
  "method": {
    "name": "hungarian",
    "params": {}
  },
  "validation": {
    "smd_threshold": 0.1,
    "balance_metrics": [
      "smd",
      "variance_ratio",
      "ks",
      "chi_square",
      "jensen_shannon"
    ],
    "success_criteria": {
      "min_match_rate": 0.5,
      "max_mean_abs_smd": 0.1,
      "max_abs_smd": 0.2,
      "min_pct_balanced": 80.0
    },
    "analysis": {
      "pca": true,
      "distributions": true,
      "correlations": true,
      "ps_support": true
    },
    "max_distribution_plots": 6,
    "plots": true,
    "hooks": []
  },
  "options": {
    "drop_rows_with_missing": false,
    "random_state": 42
  },
  "estimation": {
    "enabled": false,
    "estimands": [
      "ATT"
    ],
    "outcomes": [
    ],
    "bootstrap": {
      "n_boot": 200,
      "ci_level": 0.95,
      "resample": "full_pipeline",
      "n_jobs": 1
    }
  }
}